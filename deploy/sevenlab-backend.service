[Unit]
Description=SevenLab PDF Chat — FastAPI backend (uvicorn)
Documentation=https://github.com/bosmadev/sevenlab
After=network-online.target
Wants=network-online.target
# Service degrades gracefully if Mongo/Postgres are offline; no hard dep.

[Service]
Type=simple
User=dennis
Group=dennis
WorkingDirectory=/opt/sevenlab/backend

# Load secrets (APP_PASSWORD_HASH, AZURE_AI_API_KEY, MONGODB_URI, POSTGRESQL_URI,
# SESSION_SECRET). File must be 0600 and owned by the User= account.
# Unit-level defaults. A key present in the EnvironmentFile overrides these.
#   APP_ENV=production        marks the session cookie Secure (Caddy owns TLS)
#                             and makes app/services/pdf_sandbox.py REFUSE
#                             inline parsing of uploads (ISO 27001 A.8.7).
#   PDF_SANDBOX_MODE=docker   run sanitizer + extractor in sevenlab-pdf-worker.
Environment=APP_ENV=production
Environment=PDF_SANDBOX_MODE=docker
Environment=PDF_SANDBOX_IMAGE=sevenlab-pdf-worker:latest
EnvironmentFile=/opt/sevenlab/backend/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Reranker weights (BAAI/bge-reranker-v2-m3) live outside the rsync tree and
# outside the read-only $HOME; install.sh pre-fetches them here.
Environment=HF_HOME=/var/cache/sevenlab/huggingface

# Bind 127.0.0.1 — Caddy fronts TLS and routes /api/* to this port.
# 2 workers: each loads the ~2.3 GB cross-encoder on first chat, and 4 of them
# would exceed MemoryMax below.
ExecStart=/opt/sevenlab/backend/.venv/bin/uvicorn \
    app.main:app \
    --host 127.0.0.1 \
    --port 8001 \
    --workers 2 \
    --proxy-headers \
    --forwarded-allow-ips=127.0.0.1 \
    --log-level info

Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

# Hardening — PDF processing runs sandboxed in Docker (app/services/pdf_sandbox.py),
# so the backend itself only needs the venv and the .env file writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/opt/sevenlab/backend/logs /var/cache/sevenlab
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false

# Resource caps (plan § Processing security: 2GB per worker, 500 pages, 5m timeout).
MemoryHigh=6G
MemoryMax=8G
TasksMax=512
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sevenlab-backend

[Install]
WantedBy=multi-user.target
