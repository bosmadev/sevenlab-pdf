# sevenlab-pdf backend env sample. Copy to backend/.env (gitignored) and fill in.
# NEVER commit the real .env. Hooks and .gitignore both block it; still, double-check.

APP_ENV=development
HOST=127.0.0.1
PORT=8700
WORKERS=4

# Auth (bcrypt cost 12 hash of the login password)
APP_PASSWORD_HASH=
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=604800

# Databases
MONGODB_URI=
MONGODB_DB_NAME=sevenlab_pdf
POSTGRESQL_URI=postgresql+psycopg://sevenlab:sevenlab@127.0.0.1:5432/sevenlab

# Azure AI (Cohere Embed V5-Pro + Computer Vision v4)
AZURE_AI_API_BASE=https://15-ai1-swe.services.ai.azure.com
AZURE_AI_API_KEY=

# Upload limits
MAX_PDF_SIZE_MB=50
MAX_PDF_PAGES=500

# Embeddings
EMBEDDING_MODEL=Cohere-Embed-V5-Pro
EMBEDDING_DIMENSIONS=2048
