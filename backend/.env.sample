# === SevenLab PDF Chat — backend env vars (sample) ===
# Copy to backend/.env and fill in real values. NEVER commit backend/.env.

# --- PostgreSQL ---
POSTGRESQL_URI=postgresql+psycopg://sevenlab:CHANGEME@127.0.0.1:5432/sevenlab_pdf
POSTGRESQL_POOL_SIZE=10
POSTGRESQL_MAX_OVERFLOW=20

# --- MongoDB Atlas (credentials live in SEVENLAB-PDFCHAT.md § MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://dennis_db_user:REPLACE_WITH_REAL_PASSWORD@sevenlab.bsbpajx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=sevenlab_pdf

# --- Cohere Embed V5-Pro on Azure ---
AZURE_AI_API_BASE=https://15-ai1-swe.services.ai.azure.com
AZURE_AI_API_KEY=REPLACE_WITH_REAL_KEY
COHERE_EMBED_MODEL=Cohere-Embed-V5-Pro
COHERE_EMBED_DIM=2048

# --- Auth (T-002) ---
# APP_PASSWORD_HASH: bcrypt hash of the login password. Generate with:
#     python backend/scripts/hash_password.py
# APP_SECONDARY_HASHES (optional): comma-separated extra tenants. Format:
#     label:$2b$12$...,label2:$2b$12$...,$2b$12$...   (bare hash -> opaque u_<sha>)
# APP_ENV: `production` makes the session cookie `Secure` (requires HTTPS).
APP_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH_COST_12
APP_SECONDARY_HASHES=
SESSION_SECRET=REPLACE_WITH_32_RANDOM_BYTES_HEX
SESSION_MAX_AGE=604800
APP_ENV=development

# --- Upload limits ---
MAX_PDF_SIZE_MB=50
MAX_PDF_PAGES=500

# --- PDF sandbox (ISO 27001 A.8.7) ---
# docker  — run sanitizer+extractor in Dockerfile.pdf-worker (production)
# inline  — run in-process (dev/CI only; unsafe for untrusted uploads)
PDF_SANDBOX_MODE=docker
PDF_SANDBOX_IMAGE=sevenlab-pdf-worker:latest
PDF_SANDBOX_TIMEOUT_S=300
PDF_SANDBOX_MEMORY=2g
PDF_SANDBOX_CPUS=2
PDF_SANDBOX_PIDS_LIMIT=100

# --- Azure OpenAI chat completion (T-012 RAG) ---
# Same AZURE_AI_API_BASE and AZURE_AI_API_KEY as embeddings.
# LLM_DEPLOYMENT must match the Azure deployment name (e.g. gpt-4o).
LLM_DEPLOYMENT=gpt-4o
LLM_API_VERSION=2024-10-21
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

# --- RAG pipeline (T-012) ---
RAG_TOP_K=8
RAG_MAX_CONTEXT_CHARS=12000

# --- Server ---
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
