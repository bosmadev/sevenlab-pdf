####################################################################
# PDF processing sandbox — ISO 27001 A.8.7
#
# Runs sanitizer + extractor on an untrusted PDF with:
#   --network=none              (no outbound)
#   --read-only                 (fs immutable; writable /tmp via tmpfs)
#   --user 65534:65534          (nobody)
#   --pids-limit=100            (fork bomb cap)
#   --memory=2g --cpus=2        (resource cap)
#   -i (stdin: pdf bytes)       (no file mount — zero attack surface)
#   stdout: JSON report
#
# Build:  docker build -f backend/Dockerfile.pdf-worker -t sevenlab-pdf-worker .
# Run:    cat input.pdf | docker run --rm -i \
#           --network=none --read-only --tmpfs /tmp \
#           --user 65534:65534 --pids-limit=100 --memory=2g --cpus=2 \
#           sevenlab-pdf-worker
####################################################################

FROM python:3.11-slim-bookworm AS base

# Pin system packages for reproducibility and remove apt lists.
# tesseract is included because tier-2 OCR (T-005) runs in the same sandbox.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
         tesseract-ocr \
         libtesseract5 \
         libmagic1 \
         fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*

# App user (nobody is uid 65534 on Debian).
WORKDIR /app

# Narrow dependency list — the sandbox never speaks to Mongo / Azure.
COPY backend/requirements-worker.txt /app/requirements-worker.txt
RUN pip install --no-cache-dir -r /app/requirements-worker.txt

# Worker code only. No .env, no secrets, no routes.
COPY backend/app/__init__.py                 /app/app/__init__.py
COPY backend/app/services/__init__.py        /app/app/services/__init__.py
COPY backend/app/services/pdf_sanitizer.py   /app/app/services/pdf_sanitizer.py
COPY backend/app/services/pdf_extractor.py   /app/app/services/pdf_extractor.py
COPY backend/app/services/pdf_validator.py   /app/app/services/pdf_validator.py
COPY backend/pdf_worker.py                   /app/pdf_worker.py

ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/tmp \
    TMPDIR=/tmp

# Drop to the unprivileged `nobody` user. Image is otherwise owned by root,
# which is fine because `--read-only` makes the whole filesystem immutable
# at runtime; only /tmp (tmpfs) is writable, and `nobody` can write there.
USER 65534:65534

ENTRYPOINT ["python", "/app/pdf_worker.py"]
